# Bouncer backend configuration. Copy to `.env` and fill in.
# Variables are validated at startup (src/config.ts); in production the app fails closed
# if the items marked [prod-required] are missing or weak.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | production | test
PORT=3000
FRONTEND_URL=http://localhost:5173    # exact origin of the admin UI (used for CORS + redirects)

# Postgres connection. In production use TLS: append ?sslmode=require (or verify-full).
DATABASE_URL=postgresql://bouncer:bouncer@localhost:5432/bouncer

# Session signing secret. [prod-required: >= 32 chars] Generate: openssl rand -base64 48
SESSION_SECRET=change-me-min-16-chars-dev-only

# Comma-separated emails allowed to bootstrap the FIRST global admin. [prod-required]
# Closes the "first OAuth sign-in wins global admin" race. e.g. you@example.com,ops@example.com
ADMIN_ALLOWED_EMAILS=

# Base64-encoded 32-byte key encrypting PII (email) at rest. [prod-required]
# Generate: openssl rand -base64 32   (after enabling, run: npx tsx scripts/encrypt-emails.ts)
ENCRYPTION_KEY=

# Express trust-proxy setting for running behind a reverse proxy / TLS terminator.
# Defaults to 1 (trust first hop) in production. Examples: true | false | 1 | 10.0.0.0/8
# TRUST_PROXY=1

# ── OAuth providers ───────────────────────────────────────────────────────────
# At least one provider (id + secret) is [prod-required]. Callback URLs must match the
# provider console and point at <backend>/auth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback
