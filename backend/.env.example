# Bouncer backend configuration. Copy to `.env` and fill in.
# Variables are validated at startup (src/config.ts); the app fails closed — in every NODE_ENV —
# if the items marked [required] are missing or weak. NODE_ENV only changes the log format.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | production | test
PORT=3000
FRONTEND_URL=http://localhost         # externally-visible origin of the Bouncer app. Used for OAuth post-auth redirects and the inviteUrl returned by POST /api/v1/invitations. The backend serves both the SPA and the API from this origin (single-image deployment).

# Postgres connection. In production use TLS: append ?sslmode=require (or verify-full).
# The password is POSTGRES_PASSWORD below (runBouncer.sh fills both when it generates .env).
DATABASE_URL=postgresql://bouncer:<POSTGRES_PASSWORD>@localhost:5432/bouncer

# Apply pending prisma/migrations on startup with the built-in runner (default true). Set to
# false to manage migrations yourself (e.g. `npx prisma migrate deploy` in a release step).
# MIGRATE_ON_START=true

# Postgres credentials for the docker-compose stack (interpolated into docker-compose.yml
# for both the postgres init and the backend's container-side DATABASE_URL). Ignored by
# the host-side dev flow — that path uses DATABASE_URL above.
POSTGRES_USER=bouncer
# [required] No default. URL-safe characters only (it is embedded in DATABASE_URL); must match the
# password in DATABASE_URL above. Generate: openssl rand -hex 24. Postgres reads it only when the
# volume is first created — to change it later, run ALTER USER inside the database too.
POSTGRES_PASSWORD=
POSTGRES_DB=bouncer

# Session signing secret. [required: >= 32 chars] Generate: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated emails allowed to bootstrap the FIRST global admin. [required]
# Closes the "first OAuth sign-in wins global admin" race. e.g. you@example.com,ops@example.com
ADMIN_ALLOWED_EMAILS=

# Base64-encoded 32-byte key encrypting PII (email) at rest. [required]
# Generate: openssl rand -base64 32   (after enabling, run: npx tsx scripts/encrypt-emails.ts)
ENCRYPTION_KEY=

# Express trust-proxy setting for running behind a reverse proxy / TLS terminator.
# Unset/empty: trust 1 hop when FRONTEND_URL is https://, nothing when it is http://.
# Examples: true | false | 1 | 2 | 10.0.0.0/8
# TRUST_PROXY=

# Local debugging only: include internal error text in 500 responses. Never on a reachable server.
# EXPOSE_ERROR_DETAILS=false

# ── OAuth providers ───────────────────────────────────────────────────────────
# Configure at least one provider (id + secret), or nobody can sign in (startup warns). Callback URLs must match the
# provider console and point at <backend>/auth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost/auth/microsoft/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost/auth/github/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost/auth/linkedin/callback
