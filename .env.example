# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://bouncer:bouncer@localhost:5432/bouncer"

# ── Secrets (required in every NODE_ENV; the app refuses to start without them) ─
# Session signing secret, >= 32 chars. Generate: openssl rand -base64 48
SESSION_SECRET=""
# Base64-encoded 32-byte key encrypting user emails at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# ── Admin Bootstrap (required) ────────────────────────────────────────────────
# Comma-separated emails allowed to become the FIRST global admin (the first matching OAuth
# sign-in). Further admins are added by invitation.
ADMIN_ALLOWED_EMAILS=""

# ── OAuth: Google ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# ── OAuth: Microsoft ──────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_CALLBACK_URL="http://localhost:3000/auth/microsoft/callback"

# ── OAuth: GitHub ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# ── OAuth: LinkedIn ───────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="http://localhost:3000/auth/linkedin/callback"